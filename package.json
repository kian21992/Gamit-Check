{
  "name": "gamit-check",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n client,api -c green,blue \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "node --watch server/index.js",
    "db:local": "node server/scripts/local-db.js",
    "start": "node server/index.js",
    "start:server": "node server/index.js",
    "db:migrate": "node server/scripts/migrate.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:unit": "node --test tests/validation.test.js",
    "test:api": "node --test tests/api.integration.test.js",
    "test:e2e": "node --test tests/crud.e2e.test.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.5",
    "embedded-postgres": "^18.4.0-beta.17",
    "playwright": "^1.55.1",
    "vite": "^6.0.5"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "esbuild@0.25.12": true
  }
}
